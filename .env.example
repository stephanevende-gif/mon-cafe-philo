# Base PostgreSQL (hébergement européen recommandé)
DATABASE_URL=postgres://cafe:cafe@localhost:5432/cafephilo

# Adresse publique de l'application (liens dans les e-mails)
APP_URL=http://localhost:3000

# Envoi des e-mails (vérification de compte, mot de passe oublié).
# Sans SMTP_HOST, les e-mails sont affichés dans la console du serveur (développement uniquement).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Mon café philo <ne-pas-repondre@example.org>"

# Automatisation YouTube (étape 5).
# Clé « YouTube Data API v3 » créée dans Google Cloud Console (lecture seule, restreinte à cette API).
YOUTUBE_API_KEY=
# Playlist des Shorts (par défaut : celle des Éditions M-Éditer).
YOUTUBE_PLAYLIST_ID=PL2d4vA4vfs79RPBnT3PFdOjyXaWPdquGv
# Secret partagé avec le planificateur qui appelle POST /api/taches chaque heure (au moins 16 caractères).
CRON_SECRET=
# Facultatif : propositions de thème, question et synthèse par Claude, toujours soumises à validation humaine.
ANTHROPIC_API_KEY=
# Si l'hébergeur réserve le nom ANTHROPIC_API_KEY, mettre la même clé ici (prioritaire).
CAFE_PHILO_ANTHROPIC_KEY=

# Version de test : code à donner aux testeurs, demandé à l'inscription (laisser vide pour une inscription libre).
TESTER_ACCESS_CODE=

# Base PostgreSQL (hébergement européen recommandé)
DATABASE_URL=postgres://cafe:cafe@localhost:5432/cafephilo

# Adresse publique de l'application (liens dans les e-mails)
APP_URL=http://localhost:3000

# Envoi des e-mails (vérification de compte, mot de passe oublié).
# Sans SMTP_HOST, les e-mails sont affichés dans la console du serveur (développement uniquement).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Mon café philo <ne-pas-repondre@example.org>"
